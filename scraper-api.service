[Unit]
Description=Google Maps Scraper API Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/google-maps-scraper
ExecStart=/usr/bin/python3 /opt/google-maps-scraper/api-server.py
Restart=always
RestartSec=10
Environment=API_PORT=8080
Environment=MAX_DAILY=100
Environment=DAYS_TO_KEEP=90
Environment=OUTPUT_DIR=/opt/google-maps-scraper/output

[Install]
WantedBy=multi-user.target
